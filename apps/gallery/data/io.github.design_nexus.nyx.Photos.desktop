[Desktop Entry]
Name=Photos
GenericName=Photo Gallery
Comment=A fast, keyboard-first photo gallery
Exec=nyx-photos %F
Icon=io.github.design_nexus.nyx.Photos
Terminal=false
Type=Application
Categories=Graphics;Photography;Viewer;
Keywords=photos;gallery;viewer;pictures;exif;albums;
MimeType=image/jpeg;image/png;image/webp;image/tiff;image/bmp;image/gif;image/avif;
StartupWMClass=io.github.design_nexus.nyx.Photos
StartupNotify=true
